{
  "version": 2,
  "functions": {
    "api/stock.js": {
      "maxDuration": 30
    },
    "api/monitor.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/monitor",
      "schedule": "*/5 0-5 * * 1-5"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
